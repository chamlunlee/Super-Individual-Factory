# OpenAI 兼容接口（可选；不配置则使用示例/模板模式）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepSeek（推荐；也可用 DEEPSEEK_API_KEY，会默认走 deepseek-chat）
# DEEPSEEK_API_KEY=
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 也兼容以下别名：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# xAI Grok 示例：
# LLM_API_KEY=xai-xxx
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-2-latest

# Black Card 成片引擎（本机 studio:web）
BLACK_CARD_BASE_URL=http://127.0.0.1:3456
